{
  "name": "mibeca-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env src/server.js",
    "build": "npm run check",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:migrate:env": "node scripts/migrate.js",
    "db:create-admin": "node --env-file=.env scripts/create-admin.js",
    "db:bootstrap-admin": "node --env-file=.env scripts/bootstrap-admin.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/*.test.js\"",
    "check": "node scripts/check-syntax.js",
    "audit:changed": "node .codex/hooks/audit_bridge.mjs --changed",
    "audit:all": "node .codex/hooks/audit_bridge.mjs --all --info",
    "audit:verify": "node .opencode/plugin/code-audit.verify.mjs && node .opencode/plugin/docker-guard.verify.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  }
}
