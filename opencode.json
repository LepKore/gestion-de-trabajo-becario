{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "webfetch": "deny"
  },
  "mcp": {
    // Postman para probar el contrato de docs/api-v1.md contra la API local.
    // Autenticacion por API key leida del entorno, nunca escrita en el repo:
    // define POSTMAN_API_KEY antes de abrir opencode en este repositorio.
    "postman": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/npx.cmd",
        "-y",
        // Pin explicito: sin el, npx instala la ultima publicada a mitad de
        // proyecto y puede cambiar el contrato de tools. Subir a proposito.
        "@postman/postman-mcp-server@2.14.0"
      ],
      "environment": {
        "POSTMAN_API_KEY": "{env:POSTMAN_API_KEY}"
      },
      "enabled": true,
      "timeout": 60000
    }
  }
}