{
  "description": "MiBeca: guardia local de volúmenes Docker",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Comprobando operación Docker"
          }
        ]
      }
    ]
  }
}
