# Exclusivamente desarrollo local. Copiar a .env y usar una clave local propia.
POSTGRES_USER=mibeca_dev
POSTGRES_PASSWORD=cambiar_esta_clave_local
POSTGRES_DB=mibeca_dev
POSTGRES_PORT=5432

# Node.js lee .env mediante --env-file; Compose no lo inyecta en Node.js.
# Si cambia POSTGRES_PORT o la clave, actualizar también esta URL.
DATABASE_URL=postgresql://mibeca_dev:cambiar_esta_clave_local@127.0.0.1:5432/mibeca_dev
DB_SSL_MODE=disable
MIGRATION_TARGET=local
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
