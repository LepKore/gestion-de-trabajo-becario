# Plantilla de configuración. Copiar a .env y sustituir los <...>.
# `npm run dev` y `npm start` leen este archivo; en despliegue no existe y
# mandan las variables del proveedor (que tienen prioridad sobre este archivo).

# --- Local: PostgreSQL en Docker (compose.yaml) ---
POSTGRES_USER=mibeca_dev
POSTGRES_PASSWORD=<clave-local>
POSTGRES_DB=mibeca_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mibeca_dev:<clave-local>@127.0.0.1:5432/mibeca_dev

# --- Deploy: Supabase ---
# Sustituir <...> y percent-encodificar la clave en la URL ( @ -> %40, : -> %3A ).
# El certificado público que verifica la conexión está en certs/prod-ca-2021.crt.
# DATABASE_URL=postgresql://postgres.<project-ref>:<clave>@aws-<n>-<region>.pooler.supabase.com:6543/postgres
# DB_SSL_CA_FILE=certs/prod-ca-2021.crt

# --- Opciones: cambiar según el destino activo ---
# DB_SSL_MODE: disable = local, require = Supabase (comporta verify-ca).
DB_SSL_MODE=disable
# MIGRATION_TARGET: local, supabase o render.
MIGRATION_TARGET=local

DB_POOL_MAX=5
PORT=3000
HOST=127.0.0.1
# Origen exacto del frontend. En producción, el dominio real (https://app.tudominio.com).
CORS_ORIGIN=http://localhost:5173

# --- Sesiones (todas opcionales; estos son los valores por defecto) ---
# SESSION_TTL_HOURS=8
# MIN_PASSWORD_LENGTH=10
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# COOKIE_SECURE: false en local; true obligatorio en produccion HTTPS.
# Con NODE_ENV=production se activa automáticamente.
# SESSION_SAME_SITE: lax | strict | none (none exige COOKIE_SECURE=true).
# SESSION_COOKIE_NAME=mibeca_session

# --- Primer administrador (npm run db:bootstrap-admin) ---
# Idempotente: solo crea la cuenta si no hay ningun administrador activo.
# BOOTSTRAP_ADMIN_PASSWORD vacio = se genera una temporal y se muestra una vez.
# No hay ninguna credencial por defecto en el repositorio: define una propia.
# Nunca sobrescribe una cuenta existente: cambiala despues con SQL sobre usuarios.
BOOTSTRAP_ADMIN_NOMBRE=Administración MiBeca
BOOTSTRAP_ADMIN_CORREO=admin@mibeca.local
# BOOTSTRAP_ADMIN_PASSWORD=<clave-inicial-fuerte>
# Para alta manual con preguntas por consola: npm run db:create-admin

# --- Pruebas: base exclusiva y descartable ---
# El esquema se recrea en cada ejecucion de `npm test`; nunca apunte a un
# destino de produccion. TEST_ALLOW_REMOTE=true solo para una base de pruebas.
TEST_DATABASE_URL=postgresql://mibeca_dev:<clave-local>@127.0.0.1:5432/mibeca_test