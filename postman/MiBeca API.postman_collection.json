{
  "info": {
    "_postman_id": "ddc34ef0-877e-4a54-9c96-cfe727fa912d",
    "name": "MiBeca API",
    "description": "Pruebas manuales de los endpoints definidos en openapi.yaml. Importa también MiBeca.postman_environment.json y arranca el backend local en http://127.0.0.1:3000. Configura credenciales de un ADMIN, ENCARGADO y BECARIO de prueba en el entorno antes de ejecutar cada flujo. No uses usuarios productivos para requests que crean o cambian datos. Postman gestiona la cookie mibeca_session; X-CSRF-Token se guarda automáticamente después de login o GET /auth/me. Las operaciones de escritura afectan la base local configurada.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3000/api/v1" },
    { "key": "healthBaseUrl", "value": "http://127.0.0.1:3000" },
    { "key": "csrfToken", "value": "" },
    { "key": "usuarioId", "value": "00000000-0000-4000-8000-000000000001" },
    { "key": "trabajoId", "value": "00000000-0000-4000-8000-000000000002" },
    { "key": "postulacionId", "value": "00000000-0000-4000-8000-000000000003" },
    { "key": "estudianteId", "value": "00000000-0000-4000-8000-000000000004" },
    { "key": "idempotencyKey", "value": "cierre-prueba-001" }
  ],
  "item": [
    {
      "name": "Health checks",
      "item": [
        {
          "name": "GET backend health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Backend HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Backend iniciado', () => pm.expect(pm.response.json().status).to.eql('ok'));" ] } }],
          "request": { "method": "GET", "url": "{{healthBaseUrl}}/health", "description": "Comprueba que el backend está iniciado; no requiere autenticación ni base de datos." }
        },
        {
          "name": "GET database health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Base de datos conectada (HTTP 200)', () => pm.response.to.have.status(200));", "pm.test('Base de datos disponible', () => pm.expect(pm.response.json().status).to.eql('ok'));" ] } }],
          "request": { "method": "GET", "url": "{{healthBaseUrl}}/health_db", "description": "Comprueba la conexión PostgreSQL configurada. Debe responder 200; 503 indica base de datos no disponible." }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        { "name": "Login (configura usuario/contraseña y guarda CSRF)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Login HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "if (body.data?.csrfToken) pm.collectionVariables.set('csrfToken', body.data.csrfToken);", "pm.test('Respuesta incluye csrfToken', () => pm.expect(body.data?.csrfToken).to.be.a('string').and.not.empty);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/login", "description": "Configura correo y password del rol que vas a probar. La cookie de sesión se conserva en el cookie jar de Postman." } },
        { "name": "GET sesión actual", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Sesión HTTP 200', () => pm.response.to.have.status(200));", "const body = pm.response.json();", "if (body.data?.csrfToken) pm.collectionVariables.set('csrfToken', body.data.csrfToken);", "pm.test('Devuelve usuario y CSRF', () => { pm.expect(body.data.usuario).to.exist; pm.expect(body.data.csrfToken).to.be.a('string').and.not.empty; });"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" } },
        { "name": "POST cambiar contraseña", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"passwordActual\": \"{{passwordActual}}\",\n  \"passwordNuevo\": \"{{passwordNuevo}}\",\n  \"passwordNuevoConfirmacion\": \"{{passwordNuevo}}\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/auth/change-password", "description": "Escritura: cambia de forma persistente la contraseña y revoca otras sesiones." } },
        { "name": "POST logout", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 204', () => pm.response.to.have.status(204));"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/auth/logout" } }
      ]
    },
    {
      "name": "Usuarios (ADMIN)",
      "item": [
        { "name": "GET listar usuarios", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Respuesta paginada', () => { const b=pm.response.json(); pm.expect(b.data).to.be.an('array'); pm.expect(b.meta).to.exist; });"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/users?page=1&pageSize=20" } },
        { "name": "POST crear estudiante (guarda id)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "const u=pm.response.json().data; if(u?.id) pm.collectionVariables.set('estudianteId',u.id);", "pm.test('Contraseña temporal devuelta una sola vez', () => pm.expect(u.passwordTemporal).to.be.a('string').and.not.empty);"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Estudiante Postman\",\n  \"correo\": \"{{nuevoCorreo}}\",\n  \"rol\": \"BECARIO\",\n  \"estudiante\": {\n    \"codigo\": \"{{codigoEstudiante}}\",\n    \"carrera\": \"Ingeniería de Sistemas\",\n    \"semestre\": 4,\n    \"metaMinutos\": 120\n  }\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/users", "description": "Escritura persistente. Usa un correo y código únicos. La respuesta incluye passwordTemporal; guárdala de forma segura y no compartas la respuesta." } },
        { "name": "GET usuario por id", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/users/{{usuarioId}}" } },
        { "name": "PATCH editar usuario", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "PATCH", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"nombre\": \"Usuario actualizado desde Postman\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/users/{{usuarioId}}", "description": "Escritura persistente." } },
        { "name": "POST reset password", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Incluye contraseña temporal', () => pm.expect(pm.response.json().data.passwordTemporal).to.be.a('string').and.not.empty);"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/users/{{usuarioId}}/reset-password", "description": "Escritura sensible: revoca sesiones y genera contraseña temporal nueva." } },
        { "name": "POST desactivar usuario", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/users/{{usuarioId}}/deactivate", "description": "Escritura sensible: desactiva cuenta y revoca sesiones. No ejecutar contra el último ADMIN activo." } },
        { "name": "POST reactivar usuario", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }], "url": "{{baseUrl}}/users/{{usuarioId}}/reactivate", "description": "Escritura persistente; no revive sesiones anteriores." } }
      ]
    },
    {
      "name": "Trabajos y postulaciones",
      "item": [
        { "name": "GET listar trabajos", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Respuesta paginada', () => { const b=pm.response.json(); pm.expect(b.data).to.be.an('array'); pm.expect(b.meta).to.exist; });"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/jobs?page=1&pageSize=20" } },
        { "name": "POST crear trabajo (ENCARGADO)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "const j=pm.response.json().data; if(j?.id) pm.collectionVariables.set('trabajoId',j.id);"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"titulo\": \"Trabajo de prueba Postman\",\n  \"descripcion\": \"Actividad de verificación de API\",\n  \"ubicacion\": \"Campus\",\n  \"inicioPrevisto\": \"{{inicioPrevisto}}\",\n  \"finPrevisto\": \"{{finPrevisto}}\",\n  \"duracionMinutos\": 60,\n  \"cupos\": 3\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/jobs", "description": "Escritura persistente. Requiere ENCARGADO; define inicioPrevisto/finPrevisto ISO-8601 futuros." } },
        { "name": "GET trabajo por id", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/jobs/{{trabajoId}}" } },
        { "name": "PATCH editar trabajo (ENCARGADO propietario)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "PATCH", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"descripcion\": \"Descripción actualizada desde Postman\"\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/jobs/{{trabajoId}}", "description": "Escritura persistente; solo antes del inicio y antes de cualquier aceptación." } },
        { "name": "GET postulantes del trabajo (ENCARGADO)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/jobs/{{trabajoId}}/applications?page=1&pageSize=20" } },
        { "name": "POST postular (BECARIO)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201', () => pm.response.to.have.status(201));", "const a=pm.response.json().data; if(a?.id) pm.collectionVariables.set('postulacionId',a.id);"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/jobs/{{trabajoId}}/applications", "description": "Escritura persistente. Ejecutar con sesión BECARIO; solo trabajo publicado, no iniciado y con cupo." } },
        { "name": "POST aceptar postulación (ENCARGADO)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/applications/{{postulacionId}}/accept", "description": "Escritura irreversible. Ejecutar con ENCARGADO propietario antes del inicio." } },
        { "name": "POST rechazar postulación (ENCARGADO)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/applications/{{postulacionId}}/reject", "description": "Escritura irreversible. No ejecutar sobre postulación aceptada." } },
        { "name": "GET trabajos del encargado", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/me/jobs?page=1&pageSize=20" } },
        { "name": "GET mis postulaciones (BECARIO)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/me/applications?page=1&pageSize=20" } }
      ]
    },
    {
      "name": "Control y supervisión",
      "item": [
        { "name": "POST cerrar trabajo (ENCARGADO propietario)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Incluye trabajo y asistencia', () => { const d=pm.response.json().data; pm.expect(d.job).to.exist; pm.expect(d.attendance).to.be.an('array'); });"] } }], "request": { "method": "POST", "header": [{ "key": "X-CSRF-Token", "value": "{{csrfToken}}" }, { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"attendance\": [\n    { \"applicationId\": \"{{postulacionId}}\", \"attended\": true }\n  ]\n}", "options": { "raw": { "language": "json" } } }, "url": "{{baseUrl}}/jobs/{{trabajoId}}/close", "description": "Cierre irreversible: requiere que haya llegado el fin previsto y que attendance enumere exactamente todas las postulaciones aceptadas. Usa una clave estable por intención; ejecútalo solo con datos de prueba." } },
        { "name": "GET asistencia del trabajo", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/jobs/{{trabajoId}}/attendance" } },
        { "name": "GET mi progreso (BECARIO)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Métricas de minutos', () => { const d=pm.response.json().data; pm.expect(d).to.have.property('targetMinutes'); pm.expect(d).to.have.property('accreditedMinutes'); });"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/me/progress" } },
        { "name": "GET dashboard encargado", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/me/dashboard" } },
        { "name": "GET mi historial", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));", "pm.test('Historial paginado', () => { const b=pm.response.json(); pm.expect(b.data).to.be.an('array'); pm.expect(b.meta).to.exist; });"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/me/history?page=1&pageSize=20" } },
        { "name": "GET progreso de estudiantes (ADMIN)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/students/progress?page=1&pageSize=20" } },
        { "name": "GET historial de estudiante (ADMIN)", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', () => pm.response.to.have.status(200));"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/students/{{estudianteId}}/history?page=1&pageSize=20" } }
      ]
    }
  ]
}
